#!/bin/sh
# travel-router - Wi-Fi repeater (WISP) control for the Xiaomi/Redmi AC2100
#
# The script is the single backend used by the LuCI "travel router" pages.
# It only relies on BusyBox ash and the tools shipped with OpenWrt.
#
# Subcommands:
#   status                          key=value uplink status
#   scan [--force]                  tab separated nearby networks
#   connect <ssid> <keyfile|-> <band> <enc> <hidden>
#   disconnect                      keep credentials, bring the STA link down
#   forget                          remove the STA configuration completely
#   home                            key=value dashboard data
#   clients                         tab separated DHCP/Wi-Fi client list
#   reconnect                       restart WAN and Wi-Fi
#
# <band> is one of 2g, 5g, auto. <enc> is a hostapd/wpa_supplicant
# encryption string (none, psk, psk2, psk-mixed, sae, sae-mixed, wpa, wpa2,
# wep). <hidden> is 0 or 1.

set -u

CONF="travel"
STA_IF="sta0"
SCAN_CACHE="/tmp/travel.scan"
SCAN_STAMP="/tmp/travel.scan.stamp"
SCAN_TTL=120
LOCKDIR="/var/lock/travel-router.lock"
KEYFILE="/tmp/travel.key"
WIFI_LOG="/tmp/travel-wifi.log"
DEFAULT_WIFI_KEY="ac2100travel"
SSID_2G="AC2100-Travel"
SSID_5G="AC2100-Travel-5G"

uci_get() {
	uci -q get "$1" 2>/dev/null
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: travel-router <command> [args]

  status
  setup [--no-reload]
  scan [--force]
  connect <ssid> <keyfile|-> <band> <enc> <hidden>
  disconnect
  forget
  home
  clients
  proxy status
  reconnect
EOF
}

# ---------------------------------------------------------------- helpers ---

sta_ifname() {
	local dev mode

	if iwinfo "$STA_IF" info >/dev/null 2>&1; then
		echo "$STA_IF"
		return 0
	fi

	for dev in $(iwinfo 2>/dev/null | awk '!/^[ \t]/ && NF { print $1 }'); do
		# Anchor on the leading "Mode:" line: a greedy .* would match the
		# later "HT Mode: HT40" and report HT instead of Client.
		mode=$(iwinfo "$dev" info 2>/dev/null | sed -n 's/^[[:space:]]*Mode: \([A-Za-z]*\).*/\1/p' | head -n1)
		if [ "$mode" = "Client" ]; then
			echo "$dev"
			return 0
		fi
	done

	echo "$STA_IF"
}

iface_ip() {
	ip -4 -o addr show dev "$1" 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1 | head -n1
}

iface_band() {
	local ch
	ch=$(iwinfo "$1" info 2>/dev/null | sed -n 's/.*Channel: \([0-9][0-9]*\).*/\1/p' | head -n1)
	if [ -z "$ch" ]; then
		echo "2g"
	elif [ "$ch" -gt 14 ] 2>/dev/null; then
		echo "5g"
	else
		echo "2g"
	fi
}

ap_ifnames() {
	local dev
	for dev in $(iwinfo 2>/dev/null | awk '!/^[ \t]/ && NF { print $1 }'); do
		case "$dev" in
			*:*) continue ;;
		esac
		if iwinfo "$dev" info 2>/dev/null | grep -q 'Mode: Master'; then
			echo "$dev"
		fi
	done
}

radio_band() {
	local dev="$1" band ch
	band=$(uci_get "wireless.$dev.band")
	if [ -z "$band" ]; then
		ch=$(uci_get "wireless.$dev.channel")
		case "$ch" in
			''|auto|'0') band="2g" ;;
			*)
				if [ "$ch" -gt 14 ] 2>/dev/null; then band="5g"; else band="2g"; fi
				;;
		esac
	fi
	echo "$band"
}

radio_for_band() {
	local want="$1" dev band
	for dev in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band=$(radio_band "$dev")
		if [ "$band" = "$want" ]; then
			echo "$dev"
			return 0
		fi
	done
	return 1
}

best_band_for() {
	local ssid="$1" band=""
	if [ -s "$SCAN_CACHE" ]; then
		band=$(awk -F'\t' -v s="$ssid" '$1 == s { print $4; exit }' "$SCAN_CACHE")
	fi
	echo "${band:-2g}"
}

wan_zone() {
	uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -n1
}

firewall_add_wwan() {
	local zone
	zone=$(wan_zone)
	[ -n "$zone" ] || return 0
	if ! uci -q get "firewall.$zone.network" | tr ' ' '\n' | grep -qx 'wwan'; then
		uci add_list "firewall.$zone.network=wwan"
	fi
	uci set "firewall.$zone.masq=1"
}

firewall_del_wwan() {
	local zone
	for zone in $(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.]*\)\.network=.*/\1/p" | sort -u); do
		uci -q del_list "firewall.$zone.network=wwan"
	done
}

wifi_reload_bg() {
	(
		sleep 1
		/sbin/wifi reload >"$WIFI_LOG" 2>&1
	) &
}

firewall_reload_bg() {
	(
		sleep 2
		/etc/init.d/firewall reload >/tmp/travel-firewall.log 2>&1
	) &
}

take_lock() {
	if ! mkdir "$LOCKDIR" 2>/dev/null; then
		die "另一个操作正在进行，请稍后再试"
	fi
	trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT INT TERM
}

ap_ssid_by_band() {
	local want="$1" sec dev band
	for sec in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
		[ "$(uci_get "wireless.$sec.mode")" = "ap" ] || continue
		dev=$(uci_get "wireless.$sec.device")
		[ -n "$dev" ] || continue
		band=$(radio_band "$dev")
		if [ "$band" = "$want" ]; then
			uci_get "wireless.$sec.ssid"
			return 0
		fi
	done
	return 0
}

# ------------------------------------------------------------ scan parsing ---

# scan_parse <band> : read `iwinfo <dev> scan` output from stdin and print
#   ssid <TAB> bssid <TAB> signal <TAB> band <TAB> channel <TAB> encryption
scan_parse() {
	awk -v band="$1" '
	function emit() {
		if (ssid != "") {
			gsub(/\t/, " ", ssid)
			printf "%s\t%s\t%s\t%s\t%s\t%s\n", ssid, bssid,
				(sig == "" ? "-100" : sig), band,
				(ch == "" ? "?" : ch), (enc == "" ? "unknown" : enc)
		}
		ssid = ""; bssid = ""; sig = ""; ch = ""; enc = ""
	}
	/^[ \t]*Cell [0-9]+/ {
		emit()
		if (match($0, /Address: [0-9A-Fa-f:]+/))
			bssid = substr($0, RSTART + 9, RLENGTH - 9)
		next
	}
	/ESSID:/ {
		ssid = $0
		if (ssid ~ /ESSID: ".*"/) {
			sub(/^.*ESSID: "/, "", ssid)
			sub(/".*$/, "", ssid)
		} else {
			# Hidden network: iwinfo prints the literal word "unknown".
			ssid = ""
		}
		next
	}
	/Encryption:/ {
		enc = $0
		sub(/^.*Encryption: /, "", enc)
		next
	}
	{
		if (match($0, /Channel: [0-9]+/))
			ch = substr($0, RSTART + 9, RLENGTH - 9)
		if (match($0, /Signal: -?[0-9]+/))
			sig = substr($0, RSTART + 8, RLENGTH - 8)
	}
	END { emit() }
	'
}

# ------------------------------------------------------------------ status ---

cmd_status() {
	local configured=0 disabled="" cfg_ssid="" info="" ssid="" bssid=""
	local signal="" quality="" ip="" state="unconfigured" assoc=0 sta="" sta_sec=""

	# The uplink may be configured by this script (wireless.wwan) or manually
	# in LuCI (e.g. wireless.wifinet3 with network wwan2), so detect the STA
	# section by mode instead of assuming a fixed section name.
	for _sec in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
		if [ "$(uci_get "wireless.$_sec.mode")" = "sta" ]; then
			sta_sec="$_sec"
			break
		fi
	done
	if [ -n "$sta_sec" ]; then
		configured=1
		disabled=$(uci_get "wireless.$sta_sec.disabled")
		cfg_ssid=$(uci_get "wireless.$sta_sec.ssid")
	fi
	sta=$(sta_ifname)
	ip=$(iface_ip "$sta")
	info=$(iwinfo "$sta" info 2>/dev/null || true)

	if [ -n "$info" ]; then
		ssid=$(printf '%s\n' "$info" | sed -n 's/.*ESSID: "\(.*\)".*/\1/p' | head -n1)
		bssid=$(printf '%s\n' "$info" | sed -n 's/.*Access Point: \([0-9A-Fa-f:]*\).*/\1/p' | head -n1)
		signal=$(printf '%s\n' "$info" | sed -n 's/.*Signal: \([-0-9]*\) dBm.*/\1/p' | head -n1)
		quality=$(printf '%s\n' "$info" | sed -n 's/.*Quality: \([0-9]*\/[0-9]*\).*/\1/p' | head -n1)
	fi

	[ "$ssid" = "unknown" ] && ssid=""
	if [ -n "$ssid" ]; then
		assoc=1
	fi

	if [ "$configured" = "1" ]; then
		if [ "$disabled" = "1" ]; then
			state="disabled"
		elif [ -n "$ip" ]; then
			state="connected"
		elif [ "$assoc" = "1" ]; then
			state="connecting"
		else
			state="disconnected"
		fi
	fi

	printf 'configured=%s\n' "$configured"
	printf 'state=%s\n' "$state"
	printf 'cfg_ssid=%s\n' "$cfg_ssid"
	printf 'ssid=%s\n' "$ssid"
	printf 'bssid=%s\n' "$bssid"
	printf 'signal=%s\n' "$signal"
	printf 'quality=%s\n' "$quality"
	printf 'ip=%s\n' "$ip"
	printf 'device=%s\n' "$sta"
	printf 'band=%s\n' "$(uci_get travel.settings.band)"
	printf 'mode=%s\n' "$(uci_get travel.settings.mode)"
}

# -------------------------------------------------------------------- scan ---

cmd_scan() {
	local force="${1:-}" now ts tmp dev band
	now=$(date +%s)

	if [ "$force" != "--force" ] && [ -s "$SCAN_CACHE" ] && [ -s "$SCAN_STAMP" ]; then
		ts=$(cat "$SCAN_STAMP" 2>/dev/null)
		case "$ts" in
			''|*[!0-9]*) ts=0 ;;
		esac
		if [ $((now - ts)) -lt "$SCAN_TTL" ]; then
			cat "$SCAN_CACHE"
			return 0
		fi
	fi

	tmp="$SCAN_CACHE.$$"
	: > "$tmp"
	for dev in $(ap_ifnames); do
		band=$(iface_band "$dev")
		iwinfo "$dev" scan 2>/dev/null | scan_parse "$band" >> "$tmp"
	done

	if [ -s "$tmp" ]; then
		# BusyBox sort has neither -t nor -k, so rank in awk: keep the
		# strongest BSSID per SSID, then order by signal (strongest first).
		awk -F'\t' '
			{
				ssid = $1
				sig = $3 + 0
				if (!(ssid in best) || sig > best[ssid]) {
					best[ssid] = sig
					line[ssid] = $0
				}
			}
			END { for (ssid in line) printf "%d\t%s\n", best[ssid], line[ssid] }
		' "$tmp" | sort -nr | cut -f2- > "$SCAN_CACHE"
	else
		: > "$SCAN_CACHE"
	fi
	rm -f "$tmp"
	date +%s > "$SCAN_STAMP"
	cat "$SCAN_CACHE"
}


# -------------------------------------------------------------------- setup ---

# Ensure that every detected radio has an AP interface.  Safe to run on
# every boot: existing user APs are left alone (they keep their SSID/key),
# only default "OpenWrt" APs are adopted and missing APs are created.
cmd_setup() {
	local apply="${1:-}" radio band suffix ssid ap sec dev mode
	local adopt radios="" wait=0

	# Only generate a wireless config when there is no config at all.
	# Calling "wifi config" on every boot can rewrite/overwrite a custom AP
	# (SSID/key), which makes clients ask for the password again after reboot.
	if [ ! -s /etc/config/wireless ]; then
		/sbin/wifi config >/dev/null 2>&1
	fi

	radios=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p")

	# On a fresh boot the mt76 PHYs may appear a few seconds after
	# uci-defaults has started.  Wait for them, but never rewrite the config.
	while [ -z "$radios" ] && [ "$wait" -lt 10 ]; do
		sleep 1
		radios=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p")
		wait=$((wait + 1))
	done

	[ -n "$radios" ] || return 1

	for radio in $radios; do
		band=$(radio_band "$radio")
		case "$band" in
			5g) ssid="$SSID_5G"; suffix="5g" ;;
			*)  ssid="$SSID_2G"; suffix="2g" ;;
		esac

		uci set "wireless.$radio.disabled=0"
		[ -n "$(uci_get "wireless.$radio.country")" ] || uci set "wireless.$radio.country=CN"

		ap=""
		adopt=0
		for sec in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
			[ "$(uci_get "wireless.$sec.mode")" = "ap" ] || continue
			[ "$(uci_get "wireless.$sec.device")" = "$radio" ] || continue

			if [ "$(uci_get "wireless.$sec.travel")" = "1" ]; then
				ap="$sec"
				adopt=0
				break
			fi

			if [ -z "$ap" ]; then
				ap="$sec"
				case "$(uci_get "wireless.$sec.ssid")" in
					''|OpenWrt*) adopt=1 ;;
				esac
			fi
		done

		if [ -z "$ap" ]; then
			ap="travel_ap_$suffix"
			adopt=1
			uci set "wireless.$ap=wifi-iface"
			uci set "wireless.$ap.device=$radio"
			uci set "wireless.$ap.mode=ap"
			uci set "wireless.$ap.network=lan"
		fi

		if [ "$adopt" = "1" ]; then
			uci set "wireless.$ap.ssid=$ssid"
			uci set "wireless.$ap.encryption=psk2"
			uci set "wireless.$ap.key=$DEFAULT_WIFI_KEY"
		fi

		uci set "wireless.$ap.travel=1"
		uci set "wireless.$ap.disabled=0"
		uci set "wireless.$ap.network=lan"
		uci set "wireless.$ap.isolate=0"
	done

	if [ -n "$(uci changes wireless 2>/dev/null)" ]; then
		uci commit wireless

		if [ "$apply" != "--no-reload" ]; then
			wifi_reload_bg
		fi
	fi

	# Keep a last-known-good copy.  It is only used if /etc/config/wireless is
	# missing at boot; a normal reboot must keep the committed UCI config.
	mkdir -p /etc/travel
	[ -s /etc/config/wireless ] && cp -f /etc/config/wireless /etc/travel/wireless.ap.bak

	return 0
}

# ----------------------------------------------------------------- connect ---

cmd_connect() {
	local ssid="${1:-}" keyfile="${2:-}" band="${3:-auto}" enc="${4:-psk2}"
	local hidden="${5:-0}" key="" radio=""

	[ -n "$ssid" ] || die "SSID 不能为空"
	[ "$(printf '%s' "$ssid" | wc -c)" -le 32 ] || die "SSID 不能超过 32 字节"

	case "$enc" in
		none|psk|psk2|psk-mixed|sae|sae-mixed|wpa|wpa2|wep) ;;
		*) die "不支持的加密方式: $enc" ;;
	esac

	if [ -n "$keyfile" ] && [ "$keyfile" != "-" ] && [ -f "$keyfile" ]; then
		key=$(cat "$keyfile")
		rm -f "$keyfile"
	fi

	if [ "$enc" != "none" ] && [ "$enc" != "wep" ]; then
		[ "$(printf '%s' "$key" | wc -c)" -ge 8 ] || die "Wi-Fi 密码至少需要 8 位"
		[ "$(printf '%s' "$key" | wc -c)" -le 63 ] || die "Wi-Fi 密码不能超过 63 位"
	fi

	case "$band" in
		2g|5g|auto) ;;
		*) die "频段参数无效: $band" ;;
	esac
	[ "$band" = "auto" ] && band=$(best_band_for "$ssid")
	[ -n "$band" ] || band="2g"

	radio=$(radio_for_band "$band" || true)
	[ -n "$radio" ] || die "没有找到 $band 射频，请检查无线驱动"

	take_lock

	uci set wireless.wwan=wifi-iface
	uci set wireless.wwan.device="$radio"
	uci set wireless.wwan.network='wwan'
	uci set wireless.wwan.mode='sta'
	uci set wireless.wwan.ifname="$STA_IF"
	uci set wireless.wwan.ssid="$ssid"
	uci set wireless.wwan.encryption="$enc"
	uci set wireless.wwan.hidden="$hidden"
	uci set wireless.wwan.scan_ssid="$hidden"
	uci set wireless.wwan.disabled='0'
	uci -q delete wireless.wwan.key
	if [ "$enc" != "none" ]; then
		uci set wireless.wwan.key="$key"
	fi

	uci set network.wwan=interface
	uci set network.wwan.proto='dhcp'
	uci set network.wwan.metric='20'
	uci set network.wwan.peerdns='1'

	firewall_add_wwan

	uci set travel.settings.enabled='1'
	uci set travel.settings.ssid="$ssid"
	uci set travel.settings.band="$band"
	uci set travel.settings.encryption="$enc"
	uci set travel.settings.hidden="$hidden"
	uci set travel.settings.mode='nat'

	uci commit wireless
	uci commit network
	uci commit firewall
	uci commit travel

	rm -f "$SCAN_CACHE" "$SCAN_STAMP"
	wifi_reload_bg
	firewall_reload_bg
	echo "ok"
}

cmd_disconnect() {
	take_lock
	uci set wireless.wwan.disabled='1'
	uci set travel.settings.enabled='0'
	uci commit wireless
	uci commit travel
	wifi_reload_bg
	echo "ok"
}

cmd_forget() {
	take_lock
	uci -q delete wireless.wwan
	uci -q delete network.wwan
	firewall_del_wwan
	uci set travel.settings.enabled='0'
	uci -q delete travel.settings.ssid
	uci commit wireless
	uci commit network
	uci commit firewall
	uci commit travel
	rm -f "$SCAN_CACHE" "$SCAN_STAMP"
	wifi_reload_bg
	firewall_reload_bg
	echo "ok"
}

shellcrash_api_base() {
	local hostdir port
	hostdir=$(sed -n "s/^hostdir='\(.*\)'$/\1/p" /etc/ShellCrash/configs/ShellCrash.cfg 2>/dev/null | head -n1)
	port=$(printf '%s' "$hostdir" | sed -n 's/^:\([0-9][0-9]*\).*/\1/p')
	[ -n "$port" ] || port=9998
	printf '127.0.0.1:%s' "$port"
}

shellcrash_api_secret() {
	sed -n 's/^secret=//p' /etc/ShellCrash/configs/ShellCrash.cfg 2>/dev/null | head -n1
}

shellcrash_yacd_url() {
	local lan="${1:-192.168.8.1}" hostdir port secret
	hostdir=$(sed -n "s/^hostdir='\(.*\)'$/\1/p" /etc/ShellCrash/configs/ShellCrash.cfg 2>/dev/null | head -n1)
	port=$(printf '%s' "$hostdir" | sed -n 's/^:\([0-9][0-9]*\).*/\1/p')
	[ -n "$port" ] || port=9998
	secret=$(shellcrash_api_secret)
	printf 'http://%s:%s/ui/?hostname=%s&port=%s&secret=%s' "$lan" "$port" "$lan" "$port" "$secret"
}

# ------------------------------------------------------------------- home ---

cmd_home() {
	local hostname model firmware uptime_s load mem_total mem_avail mem_free
	local mem_used mem_total_mb mem_pct mem_available_mb swap_total swap_free def_dev uplink wan_ip
	local status_out ssid signal quality relay_ip relay_state
	local clients clients_offline leases wifi_clients sc_installed sc_running rootpw lan_ip ssid_2g ssid_5g
	local proxy_group proxy_node proxy_delay yacd_url sc_base sc_secret sc_data
	local shadow dev sta

	hostname=$(uci_get system.@system[0].hostname)
	[ -n "$hostname" ] || hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null)
	model=$(cat /tmp/sysinfo/model 2>/dev/null)
	[ -n "$model" ] || model="Xiaomi Redmi AC2100"
	firmware=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'$/\1/p" /etc/openwrt_release 2>/dev/null | head -n1)

	uptime_s=$(awk '{ print int($1) }' /proc/uptime 2>/dev/null)
	load=$(awk '{ print $1 }' /proc/loadavg 2>/dev/null)
	mem_total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)
	mem_avail=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo 2>/dev/null)
	mem_total=${mem_total:-0}
	mem_avail=${mem_avail:-0}
	mem_free=$(awk '/^MemFree:/ { print $2 }' /proc/meminfo 2>/dev/null)
	swap_total=$(awk '/^SwapTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)
	swap_free=$(awk '/^SwapFree:/ { print $2 }' /proc/meminfo 2>/dev/null)
	mem_total_mb=$((mem_total / 1024))
	mem_used=$(((mem_total - mem_avail) / 1024))
	mem_available_mb=$((mem_avail / 1024))
	swap_total=$(( ${swap_total:-0} / 1024 ))
	swap_free=$(( ${swap_free:-0} / 1024 ))
	if [ "$mem_total_mb" -gt 0 ]; then
		mem_pct=$((mem_used * 100 / mem_total_mb))
	else
		mem_pct=0
	fi

	sta=$(sta_ifname)
	def_dev=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
	uplink="none"
	wan_ip=""
	if [ -n "$def_dev" ]; then
		wan_ip=$(iface_ip "$def_dev")
		if [ "$def_dev" = "$sta" ]; then
			uplink="wifi"
		else
			uplink="ethernet"
		fi
	fi

	status_out=$(cmd_status)
	ssid=$(printf '%s\n' "$status_out" | sed -n 's/^ssid=//p')
	signal=$(printf '%s\n' "$status_out" | sed -n 's/^signal=//p')
	quality=$(printf '%s\n' "$status_out" | sed -n 's/^quality=//p')
	relay_ip=$(printf '%s\n' "$status_out" | sed -n 's/^ip=//p')
	relay_state=$(printf '%s\n' "$status_out" | sed -n 's/^state=//p')

	# Derive the counters from the same data as the "clients" subcommand so the
	# dashboard cannot disagree with the client list.  Counting only the Wi-Fi
	# association list reported an online wired PC as offline.
	leases=0
	[ -f /tmp/dhcp.leases ] && leases=$(grep -c . /tmp/dhcp.leases 2>/dev/null)
	[ -n "$leases" ] || leases=0
	_clients_out=$(cmd_clients 2>/dev/null)
	clients=$(printf '%s\n' "$_clients_out" | awk -F'\t' '$7 == 1' | grep -c .)
	clients_offline=$(printf '%s\n' "$_clients_out" | awk -F'\t' '$7 == 0' | grep -c .)
	wifi_clients=$(printf '%s\n' "$_clients_out" | awk -F'\t' '$9 == "wifi"' | grep -c .)
	[ -n "$clients" ] || clients=0
	[ -n "$clients_offline" ] || clients_offline=0
	[ -n "$wifi_clients" ] || wifi_clients=0

	sc_installed=0
	[ -d /etc/ShellCrash ] && sc_installed=1
	sc_running=0
	pidof CrashCore >/dev/null 2>&1 && sc_running=1
	pidof mihomo >/dev/null 2>&1 && sc_running=1

	proxy_group=""
	proxy_node=""
	proxy_delay=""
	if [ "$sc_running" = "1" ] && command -v curl >/dev/null 2>&1 && command -v jq >/dev/null 2>&1; then
		sc_base=$(shellcrash_api_base)
		sc_secret=$(shellcrash_api_secret)
		sc_data=$(curl -s --max-time 2 -H "Authorization: Bearer $sc_secret" "http://$sc_base/proxies" 2>/dev/null)
		proxy_group=$(printf '%s' "$sc_data" | jq -r '(.proxies | to_entries | map(select(.value.type == "Selector" and .key != "GLOBAL" and ((.value.now // "") != ""))) | .[0].key) // empty' 2>/dev/null)
		[ -n "$proxy_group" ] || proxy_group="GLOBAL"
		proxy_node=$(printf '%s' "$sc_data" | jq -r --arg g "$proxy_group" '.proxies[$g].now // empty' 2>/dev/null)
		i=0
		while [ -n "$proxy_node" ] && [ "$i" -lt 5 ]; do
			next=$(printf '%s' "$sc_data" | jq -r --arg n "$proxy_node" '.proxies[$n].now // empty' 2>/dev/null)
			[ -n "$next" ] && [ "$next" != "$proxy_node" ] || break
			proxy_node="$next"
			i=$((i + 1))
		done
		proxy_delay=$(printf '%s' "$sc_data" | jq -r --arg n "$proxy_node" '(.proxies[$n].history // []) | last | .delay // empty' 2>/dev/null)
	fi

	rootpw=0
	shadow=$(awk -F: '$1 == "root" { print $2 }' /etc/shadow 2>/dev/null)
	if [ -n "$shadow" ]; then
		case "$shadow" in
			'!'*|'*'*) rootpw=0 ;;
			*) rootpw=1 ;;
		esac
	fi

	lan_ip=$(uci_get network.lan.ipaddr)
	yacd_url=$(shellcrash_yacd_url "${lan_ip:-192.168.8.1}")
	ssid_2g=$(ap_ssid_by_band 2g)
	ssid_5g=$(ap_ssid_by_band 5g)

	printf 'hostname=%s\n' "$hostname"
	printf 'model=%s\n' "$model"
	printf 'firmware=%s\n' "$firmware"
	printf 'uptime=%s\n' "${uptime_s:-0}"
	printf 'load=%s\n' "${load:-0}"
	printf 'mem_used=%s\n' "$mem_used"
	printf 'mem_total=%s\n' "$mem_total_mb"
	printf 'mem_pct=%s\n' "$mem_pct"
	printf 'mem_free=%s\n' "$((mem_free / 1024))"
	printf 'mem_available=%s\n' "$mem_available_mb"
	printf 'swap_total=%s\n' "$swap_total"
	printf 'swap_free=%s\n' "$swap_free"
	printf 'uplink=%s\n' "$uplink"
	printf 'wan_ip=%s\n' "$wan_ip"
	printf 'wan_dev=%s\n' "${def_dev:-}"
	printf 'relay_state=%s\n' "${relay_state:-unconfigured}"
	printf 'relay_ssid=%s\n' "$ssid"
	printf 'relay_signal=%s\n' "$signal"
	printf 'relay_quality=%s\n' "$quality"
	printf 'relay_ip=%s\n' "$relay_ip"
	printf 'clients=%s\n' "$clients"
	printf 'clients_offline=%s\n' "$clients_offline"
	printf 'leases=%s\n' "$leases"
	printf 'wifi_clients=%s\n' "$wifi_clients"
	printf 'shellcrash_installed=%s\n' "$sc_installed"
	printf 'shellcrash_running=%s\n' "$sc_running"
	printf 'proxy_group=%s\n' "$proxy_group"
	printf 'proxy_node=%s\n' "$proxy_node"
	printf 'proxy_delay=%s\n' "$proxy_delay"
	printf 'yacd_url=%s\n' "$yacd_url"
	printf 'rootpw=%s\n' "$rootpw"
	printf 'lan_ip=%s\n' "${lan_ip:-192.168.8.1}"
	printf 'ssid_2g=%s\n' "$ssid_2g"
	printf 'ssid_5g=%s\n' "$ssid_5g"
}

# ---------------------------------------------------------------- clients ---

cmd_clients() {
	local dev now assoc mdns conn namecache wire tab
	now=$(date +%s)
	assoc="/tmp/travel.assoc.$$"
	mdns="/tmp/travel.mdns.$$"
	conn="/tmp/travel.conn.$$"
	wire="/tmp/travel.wire.$$"
	namecache="/etc/travel/mdns.names"
	mkdir -p /etc/travel
	touch "$namecache"
	tab=$(printf '\t')
	: > "$assoc"
	: > "$mdns"
	: > "$conn"
	: > "$wire"

	for dev in $(ap_ifnames); do
		iwinfo "$dev" assoclist 2>/dev/null | awk -v d="$dev" \
			'NF >= 2 && $1 ~ /^([0-9A-Fa-f][0-9A-Fa-f]:){5}[0-9A-Fa-f][0-9A-Fa-f]$/ {
				print tolower($1) "\t" $2 "\t" d
			}' >> "$assoc"

		# iw reports the real association age; iwinfo does not.
		iw dev "$dev" station dump 2>/dev/null | awk '
			/^Station / { mac = $2 }
			/connected time:/ { print tolower(mac) "\t" $3 }
		' >> "$conn"
	done

	# Wired clients: bridge forwarding table entries that are not Wi-Fi
	# stations.  The iproute2 "bridge" tool is not installed in this image,
	# so fall back to brctl and finally to ARP state for DHCP leases.
	if command -v bridge >/dev/null 2>&1; then
		bridge fdb show br br-lan 2>/dev/null | awk '
			$2 == "dev" && $3 ~ /^(lan|eth)/ {
				print tolower($1) "\t" $3
			}
		' >> "$wire"
	elif command -v brctl >/dev/null 2>&1; then
		brctl showmacs br-lan 2>/dev/null | awk -v af="$assoc" '
			BEGIN { while ((getline l < af) > 0) { split(l, p, "\t"); wifi[tolower(p[1])] = 1 } }
			$3 == "no" && $2 ~ /^([0-9A-Fa-f][0-9A-Fa-f]:){5}[0-9A-Fa-f][0-9A-Fa-f]$/ {
				m = tolower($2)
				if (!(m in wifi)) print m "\twired"
			}
		' >> "$wire"
	fi
	if [ ! -s "$wire" ] && [ -f /tmp/dhcp.leases ]; then
		while read -r _exp mac ip _host _rest; do
			grep -q "^$mac " "$assoc" && continue
			state=$(ip neigh show "$ip" 2>/dev/null | awk '{ print $NF }')
			case "$state" in
				REACHABLE|DELAY|PROBE) printf '%s\twired\n' "$mac" >> "$wire" ;;
			esac
		done < /tmp/dhcp.leases
	fi

	# Resolve device names advertised over mDNS (iPhone/iPad/Mac/Apple TV...).
	if command -v jq >/dev/null 2>&1 && ubus list 2>/dev/null | grep -qx umdns; then
		ubus call umdns browse 2>/dev/null | jq -r '
			to_entries[] as $svc
			| $svc.value | to_entries[]
			| select(.value.ipv4 != null and .value.ipv4 != "")
			| [.value.ipv4, .key,
			   (if $svc.key == "_device-info._tcp" then 1
			    elif $svc.key == "_airplay._tcp" then 2
			    elif $svc.key == "_companion-link._tcp" then 3
			    else 9 end)] | @tsv
		' 2>/dev/null | awk -F'\t' '
			{
				ip = $1; name = $2; prio = $3 + 0
				if (ip ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && name != "" &&
				    (!(ip in best) || prio < bestp[ip])) {
					best[ip] = name
					bestp[ip] = prio
				}
			}
			END { for (ip in best) print ip "\t" best[ip] }
		' > "$mdns"
	fi

	# Remember names across mDNS advertisements, which are intermittent.
	if [ -s "$mdns" ] && [ -f /tmp/dhcp.leases ]; then
		while IFS="$(printf '	')" read -r ip name; do
			[ -n "$ip" ] || continue
			mac=$(awk -v ip="$ip" 'NF >= 4 && $3 == ip { print tolower($2); exit }' /tmp/dhcp.leases)
			[ -n "$mac" ] || continue
			grep -v "^$mac " "$namecache" > "$namecache.tmp" 2>/dev/null
			echo "$mac $name" >> "$namecache.tmp"
			mv -f "$namecache.tmp" "$namecache"
		done < "$mdns"
	fi

	if [ -f /tmp/dhcp.leases ]; then
		awk -v now="$now" -v af="$assoc" -v mf="$mdns" -v cf="$conn" -v wf="$wire" -v nf="$namecache" '
			FILENAME == af { sig[tolower($1)] = $2; ifc[tolower($1)] = $3; next }
			FILENAME == cf { age[tolower($1)] = $2 + 0; next }
			FILENAME == wf { wired[tolower($1)] = 1; wport[tolower($1)] = $2; next }
			FILENAME == mf { name[$1] = $2; next }
			FILENAME == nf { cached[tolower($1)] = $2; next }
			NF >= 4 {
				ip = $3; mac = tolower($2); host = $4; expiry = $1
				if (cached[mac] != "") host = cached[mac]
				else if (name[ip] != "") host = name[ip]
				if (host == "*" || host == "?" || host == "") host = "未知设备"
				left = (expiry > 0) ? int((expiry - now) / 60) : -1
				if (mac in sig) kind = "wifi"
				else if (mac in wired) kind = "wired"
				else kind = "offline"
				online = (kind == "offline") ? 0 : 1
				connected = (kind == "wifi" && (mac in age)) ? age[mac] : 0
				iface = (kind == "wifi") ? ifc[mac] : ((kind == "wired") ? wport[mac] : "")
				prio = (kind == "wifi") ? 0 : ((kind == "wired") ? 1 : 2)
				key = (1 - online) "\t" prio "\t" (999999999 - connected)
				print key "\t" ip "\t" mac "\t" host "\t" sig[mac] "\t" iface "\t" left "\t" online "\t" connected "\t" kind
			}
		' "$assoc" "$conn" "$wire" "$mdns" "$namecache" /tmp/dhcp.leases \
			| sort | cut -f4-
	fi

	rm -f "$assoc" "$mdns" "$conn" "$wire"
}

# ------------------------------------------------------------------ proxy ---

cmd_proxy() {
	local action="${1:-status}" d
	local sc_installed=0 sc_running=0 sc_dir="" sc_core="" sc_core_version="" sc_autostart=0 yacd_url=""

	for d in /etc/ShellCrash /usr/share/ShellCrash; do
		if [ -d "$d" ]; then
			sc_installed=1
			sc_dir="$d"
		fi
	done
	[ -x /usr/bin/crash ] && sc_installed=1
	pidof CrashCore >/dev/null 2>&1 && sc_running=1
	pidof mihomo >/dev/null 2>&1 && sc_running=1
	pidof sing-box >/dev/null 2>&1 && sc_running=1
	if [ -n "$sc_dir" ] && [ -f "$sc_dir/configs/ShellCrash.cfg" ]; then
		sc_core=$(sed -n 's/^crashcore=//p' "$sc_dir/configs/ShellCrash.cfg" | head -n1)
		sc_core_version=$(sed -n 's/^core_v=//p' "$sc_dir/configs/ShellCrash.cfg" | head -n1)
	fi
	[ -L /etc/rc.d/S99shellcrash ] && sc_autostart=1

	case "$action" in
		status)
			printf 'shellcrash_installed=%s\n' "$sc_installed"
			printf 'shellcrash_running=%s\n' "$sc_running"
			printf 'shellcrash_dir=%s\n' "$sc_dir"
			printf 'shellcrash_core=%s\n' "$sc_core"
			printf 'shellcrash_core_version=%s\n' "$sc_core_version"
			printf 'shellcrash_autostart=%s\n' "$sc_autostart"
			yacd_url=$(shellcrash_yacd_url "$(uci_get network.lan.ipaddr)")
			printf 'yacd_url=%s\n' "$yacd_url"
			;;
		*)
			die "未知的 proxy 操作: $action"
			;;
	esac
}

cmd_shellcrash() {
	local action="${1:-status}" core="${2:-}" src cfgdir ver was_running

	case "$action" in
		start|stop|toggle)
			[ -x /etc/ShellCrash/start.sh ] || die "ShellCrash 未安装"
			case "$action" in
				start) /etc/ShellCrash/start.sh start >/tmp/travel-shellcrash.log 2>&1 ;;
				stop) /etc/ShellCrash/start.sh stop >/dev/null 2>&1 ;;
				toggle)
					if pidof CrashCore >/dev/null 2>&1; then
						/etc/ShellCrash/start.sh stop >/dev/null 2>&1
					else
						/etc/ShellCrash/start.sh start >/tmp/travel-shellcrash.log 2>&1
					fi
					;;
			esac
			sleep 2
			if pidof CrashCore >/dev/null 2>&1; then echo "running=1"; else echo "running=0"; fi
			;;
		status)
			printf 'installed=%s\n' "$([ -d /etc/ShellCrash ] && echo 1 || echo 0)"
			printf 'running=%s\n' "$(pidof CrashCore >/dev/null 2>&1 && echo 1 || echo 0)"
			printf 'core=%s\n' "$(sed -n 's/^crashcore=//p' /etc/ShellCrash/configs/ShellCrash.cfg 2>/dev/null | head -n1)"
			printf 'core_version=%s\n' "$(sed -n 's/^core_v=//p' /etc/ShellCrash/configs/ShellCrash.cfg 2>/dev/null | head -n1)"
			printf 'autostart=%s\n' "$([ -L /etc/rc.d/S99shellcrash ] && echo 1 || echo 0)"
			;;
		core)
			case "$core" in
				mihomo|meta)
					src=/etc/ShellCrash/CrashCore.mihomo
					cfgdir=meta
					ver=$(/etc/ShellCrash/CrashCore.mihomo -v 2>/dev/null | awk '{ print $3; exit }')
					;;
				singbox|sing-box)
					src=/etc/ShellCrash/CrashCore.singbox
					cfgdir=singboxr
					ver=$(/etc/ShellCrash/CrashCore.singbox version 2>/dev/null | awk '/^sing-box version/ { print $3; exit }')
					;;
				*)
					die "未知内核: $core（可选 mihomo / singbox）"
					;;
			esac
			[ -f "$src" ] || die "内核备份不存在: $src"
			if [ "$cfgdir" = "singboxr" ] && [ ! -s /etc/ShellCrash/jsons/config.json ]; then
				die "当前只有 Clash YAML 配置；sing-box 需要 sing-box JSON 订阅，请先在 ShellCrash 配置管理中导入对应订阅"
			fi
			was_running=0
			pidof CrashCore >/dev/null 2>&1 && was_running=1
			[ "$was_running" = "1" ] && /etc/ShellCrash/start.sh stop >/dev/null 2>&1
			cp -f "$src" /etc/ShellCrash/CrashCore.raw
			chmod 755 /etc/ShellCrash/CrashCore.raw
			sed -i "s/^crashcore=.*/crashcore=$cfgdir/" /etc/ShellCrash/configs/ShellCrash.cfg
			sed -i "s/^core_v=.*/core_v=$ver/" /etc/ShellCrash/configs/ShellCrash.cfg
			if [ "$cfgdir" = "meta" ]; then
				echo 'COMMAND="$TMPDIR/CrashCore -d $BINDIR -f $TMPDIR/config.yaml"' > /etc/ShellCrash/configs/command.env
			else
				echo 'COMMAND="$TMPDIR/CrashCore run -D $BINDIR -C $TMPDIR/jsons"' > /etc/ShellCrash/configs/command.env
			fi
			[ "$was_running" = "1" ] && ( /etc/ShellCrash/start.sh start >/tmp/travel-shellcrash.log 2>&1 & )
			printf 'ok core=%s version=%s\n' "$cfgdir" "$ver"
			;;
		*)
			die "未知 ShellCrash 操作: $action"
			;;
	esac
}

cmd_reconnect() {
	(
		/sbin/ifup wan >/dev/null 2>&1
		/sbin/ifup wwan >/dev/null 2>&1
		sleep 1
		/sbin/wifi reload >"$WIFI_LOG" 2>&1
	) &
	echo "ok"
}

# ------------------------------------------------------------------- main ---

main() {
	case "${1:-}" in
		status) cmd_status ;;
		setup) cmd_setup "${2:-}" ;;
		scan) cmd_scan "${2:-}" ;;
		connect) cmd_connect "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
		disconnect) cmd_disconnect ;;
		forget) cmd_forget ;;
		home) cmd_home ;;
		clients) cmd_clients ;;
		proxy) cmd_proxy "${2:-status}" ;;
		shellcrash) cmd_shellcrash "${2:-status}" "${3:-}" ;;
		reconnect) cmd_reconnect ;;
		help|-h|--help) usage ;;
		*) usage; exit 1 ;;
	esac
}

[ -n "${TRAVEL_ROUTER_LIB:-}" ] || main "$@"
