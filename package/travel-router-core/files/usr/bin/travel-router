#!/bin/sh
# travel-router - Wi-Fi repeater (WISP) control for the Xiaomi/Redmi AC2100
#
# The script is the single backend used by the LuCI "travel router" pages.
# It only relies on BusyBox ash and the tools shipped with OpenWrt.
#
# Subcommands:
#   status                          key=value uplink status
#   scan [--force]                  tab separated nearby networks
#   connect <ssid> <keyfile|-> <band> <enc> <hidden>
#   disconnect                      keep credentials, bring the STA link down
#   forget                          remove the STA configuration completely
#   home                            key=value dashboard data
#   clients                         tab separated DHCP/Wi-Fi client list
#   openclash <status|start|stop>   OpenClash helper
#   reconnect                       restart WAN and Wi-Fi
#
# <band> is one of 2g, 5g, auto. <enc> is a hostapd/wpa_supplicant
# encryption string (none, psk, psk2, psk-mixed, sae, sae-mixed, wpa, wpa2,
# wep). <hidden> is 0 or 1.

set -u

CONF="travel"
STA_IF="sta0"
SCAN_CACHE="/tmp/travel.scan"
SCAN_STAMP="/tmp/travel.scan.stamp"
SCAN_TTL=120
LOCKDIR="/var/lock/travel-router.lock"
KEYFILE="/tmp/travel.key"
WIFI_LOG="/tmp/travel-wifi.log"
DEFAULT_WIFI_KEY="ac2100travel"
SSID_2G="AC2100-Travel"
SSID_5G="AC2100-Travel-5G"

uci_get() {
	uci -q get "$1" 2>/dev/null
}

die() {
	printf '%s\n' "$*" >&2
	exit 1
}

usage() {
	cat <<'EOF'
Usage: travel-router <command> [args]

  status
  setup [--no-reload]
  scan [--force]
  connect <ssid> <keyfile|-> <band> <enc> <hidden>
  disconnect
  forget
  home
  clients
  openclash <status|start|stop>
  proxy status
  reconnect
EOF
}

# ---------------------------------------------------------------- helpers ---

sta_ifname() {
	local dev mode

	if iwinfo "$STA_IF" info >/dev/null 2>&1; then
		echo "$STA_IF"
		return 0
	fi

	for dev in $(iwinfo 2>/dev/null | awk '!/^[ \t]/ && NF { print $1 }'); do
		mode=$(iwinfo "$dev" info 2>/dev/null | sed -n 's/.*Mode: \([A-Za-z]*\).*/\1/p' | head -n1)
		if [ "$mode" = "Client" ]; then
			echo "$dev"
			return 0
		fi
	done

	echo "$STA_IF"
}

iface_ip() {
	ip -4 -o addr show dev "$1" 2>/dev/null | awk '{ print $4 }' | cut -d/ -f1 | head -n1
}

iface_band() {
	local ch
	ch=$(iwinfo "$1" info 2>/dev/null | sed -n 's/.*Channel: \([0-9][0-9]*\).*/\1/p' | head -n1)
	if [ -z "$ch" ]; then
		echo "2g"
	elif [ "$ch" -gt 14 ] 2>/dev/null; then
		echo "5g"
	else
		echo "2g"
	fi
}

ap_ifnames() {
	local dev
	for dev in $(iwinfo 2>/dev/null | awk '!/^[ \t]/ && NF { print $1 }'); do
		case "$dev" in
			*:*) continue ;;
		esac
		if iwinfo "$dev" info 2>/dev/null | grep -q 'Mode: Master'; then
			echo "$dev"
		fi
	done
}

radio_band() {
	local dev="$1" band ch
	band=$(uci_get "wireless.$dev.band")
	if [ -z "$band" ]; then
		ch=$(uci_get "wireless.$dev.channel")
		case "$ch" in
			''|auto|'0') band="2g" ;;
			*)
				if [ "$ch" -gt 14 ] 2>/dev/null; then band="5g"; else band="2g"; fi
				;;
		esac
	fi
	echo "$band"
}

radio_for_band() {
	local want="$1" dev band
	for dev in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p"); do
		band=$(radio_band "$dev")
		if [ "$band" = "$want" ]; then
			echo "$dev"
			return 0
		fi
	done
	return 1
}

best_band_for() {
	local ssid="$1" band=""
	if [ -s "$SCAN_CACHE" ]; then
		band=$(awk -F'\t' -v s="$ssid" '$1 == s { print $4; exit }' "$SCAN_CACHE")
	fi
	echo "${band:-2g}"
}

wan_zone() {
	uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.]*\)\.name='wan'$/\1/p" | head -n1
}

firewall_add_wwan() {
	local zone
	zone=$(wan_zone)
	[ -n "$zone" ] || return 0
	if ! uci -q get "firewall.$zone.network" | tr ' ' '\n' | grep -qx 'wwan'; then
		uci add_list "firewall.$zone.network=wwan"
	fi
	uci set "firewall.$zone.masq=1"
}

firewall_del_wwan() {
	local zone
	for zone in $(uci show firewall 2>/dev/null | sed -n "s/^firewall\.\([^.]*\)\.network=.*/\1/p" | sort -u); do
		uci -q del_list "firewall.$zone.network=wwan"
	done
}

wifi_reload_bg() {
	(
		sleep 1
		/sbin/wifi reload >"$WIFI_LOG" 2>&1
	) &
}

firewall_reload_bg() {
	(
		sleep 2
		/etc/init.d/firewall reload >/tmp/travel-firewall.log 2>&1
	) &
}

take_lock() {
	if ! mkdir "$LOCKDIR" 2>/dev/null; then
		die "另一个操作正在进行，请稍后再试"
	fi
	trap 'rmdir "$LOCKDIR" 2>/dev/null' EXIT INT TERM
}

ap_ssid_by_band() {
	local want="$1" sec dev band
	for sec in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
		[ "$(uci_get "wireless.$sec.mode")" = "ap" ] || continue
		dev=$(uci_get "wireless.$sec.device")
		[ -n "$dev" ] || continue
		band=$(radio_band "$dev")
		if [ "$band" = "$want" ]; then
			uci_get "wireless.$sec.ssid"
			return 0
		fi
	done
	return 0
}

# ------------------------------------------------------------ scan parsing ---

# scan_parse <band> : read `iwinfo <dev> scan` output from stdin and print
#   ssid <TAB> bssid <TAB> signal <TAB> band <TAB> channel <TAB> encryption
scan_parse() {
	awk -v band="$1" '
	function emit() {
		if (ssid != "") {
			gsub(/\t/, " ", ssid)
			printf "%s\t%s\t%s\t%s\t%s\t%s\n", ssid, bssid,
				(sig == "" ? "-100" : sig), band,
				(ch == "" ? "?" : ch), (enc == "" ? "unknown" : enc)
		}
		ssid = ""; bssid = ""; sig = ""; ch = ""; enc = ""
	}
	/^[ \t]*Cell [0-9]+/ {
		emit()
		if (match($0, /Address: [0-9A-Fa-f:]+/))
			bssid = substr($0, RSTART + 9, RLENGTH - 9)
		next
	}
	/ESSID:/ {
		ssid = $0
		sub(/^.*ESSID: "/, "", ssid)
		sub(/".*$/, "", ssid)
		next
	}
	/Encryption:/ {
		enc = $0
		sub(/^.*Encryption: /, "", enc)
		next
	}
	{
		if (match($0, /Channel: [0-9]+/))
			ch = substr($0, RSTART + 9, RLENGTH - 9)
		if (match($0, /Signal: -?[0-9]+/))
			sig = substr($0, RSTART + 8, RLENGTH - 8)
	}
	END { emit() }
	'
}

# ------------------------------------------------------------------ status ---

cmd_status() {
	local configured=0 disabled="" cfg_ssid="" info="" ssid="" bssid=""
	local signal="" quality="" ip="" state="unconfigured" assoc=0 sta=""

	[ -n "$(uci_get wireless.wwan)" ] && configured=1
	disabled=$(uci_get wireless.wwan.disabled)
	cfg_ssid=$(uci_get wireless.wwan.ssid)
	sta=$(sta_ifname)
	ip=$(iface_ip "$sta")
	info=$(iwinfo "$sta" info 2>/dev/null || true)

	if [ -n "$info" ]; then
		ssid=$(printf '%s\n' "$info" | sed -n 's/.*ESSID: "\(.*\)".*/\1/p' | head -n1)
		bssid=$(printf '%s\n' "$info" | sed -n 's/.*Access Point: \([0-9A-Fa-f:]*\).*/\1/p' | head -n1)
		signal=$(printf '%s\n' "$info" | sed -n 's/.*Signal: \([-0-9]*\) dBm.*/\1/p' | head -n1)
		quality=$(printf '%s\n' "$info" | sed -n 's/.*Quality: \([0-9]*\/[0-9]*\).*/\1/p' | head -n1)
	fi

	[ "$ssid" = "unknown" ] && ssid=""
	if [ -n "$ssid" ]; then
		assoc=1
	fi

	if [ "$configured" = "1" ]; then
		if [ "$disabled" = "1" ]; then
			state="disabled"
		elif [ -n "$ip" ]; then
			state="connected"
		elif [ "$assoc" = "1" ]; then
			state="connecting"
		else
			state="disconnected"
		fi
	fi

	printf 'configured=%s\n' "$configured"
	printf 'state=%s\n' "$state"
	printf 'cfg_ssid=%s\n' "$cfg_ssid"
	printf 'ssid=%s\n' "$ssid"
	printf 'bssid=%s\n' "$bssid"
	printf 'signal=%s\n' "$signal"
	printf 'quality=%s\n' "$quality"
	printf 'ip=%s\n' "$ip"
	printf 'device=%s\n' "$sta"
	printf 'band=%s\n' "$(uci_get travel.settings.band)"
	printf 'mode=%s\n' "$(uci_get travel.settings.mode)"
}

# -------------------------------------------------------------------- scan ---

cmd_scan() {
	local force="${1:-}" now ts tmp dev band
	now=$(date +%s)

	if [ "$force" != "--force" ] && [ -s "$SCAN_CACHE" ] && [ -s "$SCAN_STAMP" ]; then
		ts=$(cat "$SCAN_STAMP" 2>/dev/null)
		case "$ts" in
			''|*[!0-9]*) ts=0 ;;
		esac
		if [ $((now - ts)) -lt "$SCAN_TTL" ]; then
			cat "$SCAN_CACHE"
			return 0
		fi
	fi

	tmp="$SCAN_CACHE.$$"
	: > "$tmp"
	for dev in $(ap_ifnames); do
		band=$(iface_band "$dev")
		iwinfo "$dev" scan 2>/dev/null | scan_parse "$band" >> "$tmp"
	done

	if [ -s "$tmp" ]; then
		sort -t "$(printf '\t')" -k3,3nr "$tmp" | awk -F'\t' '!seen[$1]++' > "$SCAN_CACHE"
	else
		: > "$SCAN_CACHE"
	fi
	rm -f "$tmp"
	date +%s > "$SCAN_STAMP"
	cat "$SCAN_CACHE"
}


# -------------------------------------------------------------------- setup ---

# Ensure that every detected radio has an AP interface.  Safe to run on
# every boot: existing user APs are left alone (they keep their SSID/key),
# only default "OpenWrt" APs are adopted and missing APs are created.
cmd_setup() {
	local apply="${1:-}" radio band suffix ssid ap sec dev mode
	local adopt radios=""

	radios=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p")

	if [ -z "$radios" ]; then
		/sbin/wifi config >/dev/null 2>&1
		radios=$(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-device$/\1/p")
	fi

	[ -n "$radios" ] || return 1

	for radio in $radios; do
		band=$(radio_band "$radio")
		case "$band" in
			5g) ssid="$SSID_5G"; suffix="5g" ;;
			*)  ssid="$SSID_2G"; suffix="2g" ;;
		esac

		uci set "wireless.$radio.disabled='0'"
		[ -n "$(uci_get "wireless.$radio.country")" ] || uci set "wireless.$radio.country='CN'"

		ap=""
		adopt=0
		for sec in $(uci show wireless 2>/dev/null | sed -n "s/^wireless\.\([^.]*\)=wifi-iface$/\1/p"); do
			[ "$(uci_get "wireless.$sec.mode")" = "ap" ] || continue
			[ "$(uci_get "wireless.$sec.device")" = "$radio" ] || continue

			if [ "$(uci_get "wireless.$sec.travel")" = "1" ]; then
				ap="$sec"
				adopt=0
				break
			fi

			if [ -z "$ap" ]; then
				ap="$sec"
				case "$(uci_get "wireless.$sec.ssid")" in
					''|OpenWrt*) adopt=1 ;;
				esac
			fi
		done

		if [ -z "$ap" ]; then
			ap="travel_ap_$suffix"
			adopt=1
			uci set "wireless.$ap=wifi-iface"
			uci set "wireless.$ap.device=$radio"
			uci set "wireless.$ap.mode='ap'"
			uci set "wireless.$ap.network='lan'"
		fi

		if [ "$adopt" = "1" ]; then
			uci set "wireless.$ap.ssid=$ssid"
			uci set "wireless.$ap.encryption='psk2'"
			uci set "wireless.$ap.key=$DEFAULT_WIFI_KEY"
		fi

		uci set "wireless.$ap.travel='1'"
		uci set "wireless.$ap.disabled='0'"
		uci set "wireless.$ap.network='lan'"
		uci set "wireless.$ap.isolate='0'"
	done

	if [ -n "$(uci changes wireless 2>/dev/null)" ]; then
		uci commit wireless

		if [ "$apply" != "--no-reload" ]; then
			wifi_reload_bg
		fi
	fi

	return 0
}

# ----------------------------------------------------------------- connect ---

cmd_connect() {
	local ssid="${1:-}" keyfile="${2:-}" band="${3:-auto}" enc="${4:-psk2}"
	local hidden="${5:-0}" key="" radio=""

	[ -n "$ssid" ] || die "SSID 不能为空"
	[ "$(printf '%s' "$ssid" | wc -c)" -le 32 ] || die "SSID 不能超过 32 字节"

	case "$enc" in
		none|psk|psk2|psk-mixed|sae|sae-mixed|wpa|wpa2|wep) ;;
		*) die "不支持的加密方式: $enc" ;;
	esac

	if [ -n "$keyfile" ] && [ "$keyfile" != "-" ] && [ -f "$keyfile" ]; then
		key=$(cat "$keyfile")
		rm -f "$keyfile"
	fi

	if [ "$enc" != "none" ] && [ "$enc" != "wep" ]; then
		[ "$(printf '%s' "$key" | wc -c)" -ge 8 ] || die "Wi-Fi 密码至少需要 8 位"
		[ "$(printf '%s' "$key" | wc -c)" -le 63 ] || die "Wi-Fi 密码不能超过 63 位"
	fi

	case "$band" in
		2g|5g|auto) ;;
		*) die "频段参数无效: $band" ;;
	esac
	[ "$band" = "auto" ] && band=$(best_band_for "$ssid")
	[ -n "$band" ] || band="2g"

	radio=$(radio_for_band "$band" || true)
	[ -n "$radio" ] || die "没有找到 $band 射频，请检查无线驱动"

	take_lock

	uci set wireless.wwan=wifi-iface
	uci set wireless.wwan.device="$radio"
	uci set wireless.wwan.network='wwan'
	uci set wireless.wwan.mode='sta'
	uci set wireless.wwan.ifname="$STA_IF"
	uci set wireless.wwan.ssid="$ssid"
	uci set wireless.wwan.encryption="$enc"
	uci set wireless.wwan.hidden="$hidden"
	uci set wireless.wwan.scan_ssid="$hidden"
	uci set wireless.wwan.disabled='0'
	uci -q delete wireless.wwan.key
	if [ "$enc" != "none" ]; then
		uci set wireless.wwan.key="$key"
	fi

	uci set network.wwan=interface
	uci set network.wwan.proto='dhcp'
	uci set network.wwan.metric='20'
	uci set network.wwan.peerdns='1'

	firewall_add_wwan

	uci set travel.settings.enabled='1'
	uci set travel.settings.ssid="$ssid"
	uci set travel.settings.band="$band"
	uci set travel.settings.encryption="$enc"
	uci set travel.settings.hidden="$hidden"
	uci set travel.settings.mode='nat'

	uci commit wireless
	uci commit network
	uci commit firewall
	uci commit travel

	rm -f "$SCAN_CACHE" "$SCAN_STAMP"
	wifi_reload_bg
	firewall_reload_bg
	echo "ok"
}

cmd_disconnect() {
	take_lock
	uci set wireless.wwan.disabled='1'
	uci set travel.settings.enabled='0'
	uci commit wireless
	uci commit travel
	wifi_reload_bg
	echo "ok"
}

cmd_forget() {
	take_lock
	uci -q delete wireless.wwan
	uci -q delete network.wwan
	firewall_del_wwan
	uci set travel.settings.enabled='0'
	uci -q delete travel.settings.ssid
	uci commit wireless
	uci commit network
	uci commit firewall
	uci commit travel
	rm -f "$SCAN_CACHE" "$SCAN_STAMP"
	wifi_reload_bg
	firewall_reload_bg
	echo "ok"
}

# ------------------------------------------------------------------- home ---

cmd_home() {
	local hostname model firmware uptime_s load mem_total mem_avail
	local mem_used mem_total_mb mem_pct def_dev uplink wan_ip
	local status_out ssid signal quality relay_ip relay_state
	local clients wifi_clients oc_running oc_enabled oc_installed rootpw lan_ip ssid_2g ssid_5g
	local shadow dev sta

	hostname=$(uci_get system.@system[0].hostname)
	[ -n "$hostname" ] || hostname=$(cat /proc/sys/kernel/hostname 2>/dev/null)
	model=$(cat /tmp/sysinfo/model 2>/dev/null)
	[ -n "$model" ] || model="Xiaomi Redmi AC2100"
	firmware=$(sed -n "s/^DISTRIB_DESCRIPTION='\(.*\)'$/\1/p" /etc/openwrt_release 2>/dev/null | head -n1)

	uptime_s=$(awk '{ print int($1) }' /proc/uptime 2>/dev/null)
	load=$(awk '{ print $1 }' /proc/loadavg 2>/dev/null)
	mem_total=$(awk '/^MemTotal:/ { print $2 }' /proc/meminfo 2>/dev/null)
	mem_avail=$(awk '/^MemAvailable:/ { print $2 }' /proc/meminfo 2>/dev/null)
	mem_total=${mem_total:-0}
	mem_avail=${mem_avail:-0}
	mem_total_mb=$((mem_total / 1024))
	mem_used=$(((mem_total - mem_avail) / 1024))
	if [ "$mem_total_mb" -gt 0 ]; then
		mem_pct=$((mem_used * 100 / mem_total_mb))
	else
		mem_pct=0
	fi

	sta=$(sta_ifname)
	def_dev=$(ip route show default 2>/dev/null | awk '{ for (i = 1; i <= NF; i++) if ($i == "dev") { print $(i + 1); exit } }')
	uplink="none"
	wan_ip=""
	if [ -n "$def_dev" ]; then
		wan_ip=$(iface_ip "$def_dev")
		if [ "$def_dev" = "$sta" ]; then
			uplink="wifi"
		else
			uplink="ethernet"
		fi
	fi

	status_out=$(cmd_status)
	ssid=$(printf '%s\n' "$status_out" | sed -n 's/^ssid=//p')
	signal=$(printf '%s\n' "$status_out" | sed -n 's/^signal=//p')
	quality=$(printf '%s\n' "$status_out" | sed -n 's/^quality=//p')
	relay_ip=$(printf '%s\n' "$status_out" | sed -n 's/^ip=//p')
	relay_state=$(printf '%s\n' "$status_out" | sed -n 's/^state=//p')

	clients=0
	[ -f /tmp/dhcp.leases ] && clients=$(grep -c . /tmp/dhcp.leases 2>/dev/null)
	wifi_clients=0
	for dev in $(ap_ifnames); do
		wifi_clients=$((wifi_clients + $(iwinfo "$dev" assoclist 2>/dev/null | grep -c .)))
	done

	oc_running=0
	pidof clash >/dev/null 2>&1 && oc_running=1
	oc_installed=0
	[ -f /etc/config/openclash ] && oc_installed=1
	oc_enabled=$(uci_get openclash.config.enable)
	[ -n "$oc_enabled" ] || oc_enabled=0

	rootpw=0
	shadow=$(awk -F: '$1 == "root" { print $2 }' /etc/shadow 2>/dev/null)
	if [ -n "$shadow" ]; then
		case "$shadow" in
			'!'*|'*'*) rootpw=0 ;;
			*) rootpw=1 ;;
		esac
	fi

	lan_ip=$(uci_get network.lan.ipaddr)
	ssid_2g=$(ap_ssid_by_band 2g)
	ssid_5g=$(ap_ssid_by_band 5g)

	printf 'hostname=%s\n' "$hostname"
	printf 'model=%s\n' "$model"
	printf 'firmware=%s\n' "$firmware"
	printf 'uptime=%s\n' "${uptime_s:-0}"
	printf 'load=%s\n' "${load:-0}"
	printf 'mem_used=%s\n' "$mem_used"
	printf 'mem_total=%s\n' "$mem_total_mb"
	printf 'mem_pct=%s\n' "$mem_pct"
	printf 'uplink=%s\n' "$uplink"
	printf 'wan_ip=%s\n' "$wan_ip"
	printf 'wan_dev=%s\n' "${def_dev:-}"
	printf 'relay_state=%s\n' "${relay_state:-unconfigured}"
	printf 'relay_ssid=%s\n' "$ssid"
	printf 'relay_signal=%s\n' "$signal"
	printf 'relay_quality=%s\n' "$quality"
	printf 'relay_ip=%s\n' "$relay_ip"
	printf 'clients=%s\n' "$clients"
	printf 'wifi_clients=%s\n' "$wifi_clients"
	printf 'openclash_installed=%s\n' "$oc_installed"
	printf 'openclash_running=%s\n' "$oc_running"
	printf 'openclash_enabled=%s\n' "$oc_enabled"
	printf 'rootpw=%s\n' "$rootpw"
	printf 'lan_ip=%s\n' "${lan_ip:-192.168.8.1}"
	printf 'ssid_2g=%s\n' "$ssid_2g"
	printf 'ssid_5g=%s\n' "$ssid_5g"
}

# ---------------------------------------------------------------- clients ---

cmd_clients() {
	local dev now assoc
	now=$(date +%s)
	assoc="/tmp/travel.assoc.$$"
	: > "$assoc"

	for dev in $(ap_ifnames); do
		iwinfo "$dev" assoclist 2>/dev/null | awk -v d="$dev" \
			'NF >= 2 && $1 ~ /^([0-9A-Fa-f][0-9A-Fa-f]:){5}[0-9A-Fa-f][0-9A-Fa-f]$/ {
				print tolower($1) "\t" $2 "\t" d
			}' >> "$assoc"
	done

	if [ -f /tmp/dhcp.leases ]; then
		awk -F'\t' -v now="$now" '
			NR == FNR { sig[tolower($1)] = $2; ifc[tolower($1)] = $3; next }
			NF >= 4 {
				ip = $3; mac = tolower($2); host = $4; exp = $1
				left = (exp > 0) ? int((exp - now) / 60) : -1
				print ip "\t" mac "\t" host "\t" sig[mac] "\t" ifc[mac] "\t" left
			}
		' "$assoc" /tmp/dhcp.leases | sort -t. -k1,1n -k2,2n -k3,3n -k4,4n
	fi
	rm -f "$assoc"
}

# --------------------------------------------------------------- OpenClash ---

cmd_openclash() {
	local action="${1:-status}" installed=0 running=0 core=0
	local oc_version="" core_version="" enabled=""

	[ -f /etc/config/openclash ] && installed=1
	running=0
	pidof clash >/dev/null 2>&1 && running=1
	[ -x /etc/openclash/core/clash_meta ] && core=1
	enabled=$(uci_get openclash.config.enable)
	[ -n "$enabled" ] || enabled=0
	oc_version=$(opkg list-installed 2>/dev/null | awk '$1 == "luci-app-openclash" { print $3 }')
	if [ "$core" = "1" ]; then
		if command -v timeout >/dev/null 2>&1; then
			core_version=$(timeout 3 /etc/openclash/core/clash_meta -v 2>/dev/null | head -n1)
		else
			core_version=$(/etc/openclash/core/clash_meta -v 2>/dev/null | head -n1)
		fi
	fi

	case "$action" in
		status)
			printf 'installed=%s\n' "$installed"
			printf 'enabled=%s\n' "$enabled"
			printf 'running=%s\n' "$running"
			printf 'core=%s\n' "$core"
			printf 'oc_version=%s\n' "$oc_version"
			printf 'core_version=%s\n' "$core_version"
			;;
		start)
			[ "$installed" = "1" ] || die "OpenClash 未安装"
			[ "$core" = "1" ] || die "Mihomo 内核未安装，请先在 OpenClash 页面更新内核"
			uci -q get openclash.config >/dev/null 2>&1 || uci set openclash.config=openclash
			uci set openclash.config.enable='1'
			uci commit openclash
			/etc/init.d/openclash enable >/dev/null 2>&1
			( /etc/init.d/openclash start >/tmp/travel-openclash.log 2>&1 ) &
			echo "ok"
			;;
		stop)
			uci -q get openclash.config >/dev/null 2>&1 || uci set openclash.config=openclash
			uci set openclash.config.enable='0'
			uci commit openclash
			( /etc/init.d/openclash stop >/dev/null 2>&1 ) &
			echo "ok"
			;;
		*)
			die "未知的 OpenClash 操作: $action"
			;;
	esac
}

# ------------------------------------------------------------------ proxy ---

cmd_proxy() {
	local action="${1:-status}" d
	local oc_installed=0 oc_running=0 oc_core=0 oc_version="" oc_core_version=""
	local sc_installed=0 sc_running=0 sc_dir=""

	[ -f /etc/config/openclash ] && oc_installed=1
	pidof clash >/dev/null 2>&1 && oc_running=1
	[ -x /etc/openclash/core/clash_meta ] && oc_core=1
	oc_version=$(opkg list-installed 2>/dev/null | awk '$1 == "luci-app-openclash" { print $3 }')
	if [ "$oc_core" = "1" ]; then
		if command -v timeout >/dev/null 2>&1; then
			oc_core_version=$(timeout 3 /etc/openclash/core/clash_meta -v 2>/dev/null | head -n1)
		else
			oc_core_version=$(/etc/openclash/core/clash_meta -v 2>/dev/null | head -n1)
		fi
	fi

	for d in /etc/ShellCrash /usr/share/ShellCrash; do
		if [ -d "$d" ]; then
			sc_installed=1
			sc_dir="$d"
		fi
	done
	[ -x /usr/bin/crash ] && sc_installed=1
	pidof mihomo >/dev/null 2>&1 && sc_running=1
	pidof sing-box >/dev/null 2>&1 && sc_running=1

	case "$action" in
		status)
			printf 'openclash_installed=%s\n' "$oc_installed"
			printf 'openclash_running=%s\n' "$oc_running"
			printf 'openclash_core=%s\n' "$oc_core"
			printf 'openclash_version=%s\n' "$oc_version"
			printf 'openclash_core_version=%s\n' "$oc_core_version"
			printf 'shellcrash_installed=%s\n' "$sc_installed"
			printf 'shellcrash_running=%s\n' "$sc_running"
			printf 'shellcrash_dir=%s\n' "$sc_dir"
			;;
		*)
			die "未知的 proxy 操作: $action"
			;;
	esac
}

cmd_reconnect() {
	(
		/sbin/ifup wan >/dev/null 2>&1
		/sbin/ifup wwan >/dev/null 2>&1
		sleep 1
		/sbin/wifi reload >"$WIFI_LOG" 2>&1
	) &
	echo "ok"
}

# ------------------------------------------------------------------- main ---

main() {
	case "${1:-}" in
		status) cmd_status ;;
		setup) cmd_setup "${2:-}" ;;
		scan) cmd_scan "${2:-}" ;;
		connect) cmd_connect "${2:-}" "${3:-}" "${4:-}" "${5:-}" "${6:-}" ;;
		disconnect) cmd_disconnect ;;
		forget) cmd_forget ;;
		home) cmd_home ;;
		clients) cmd_clients ;;
		openclash) cmd_openclash "${2:-status}" ;;
		proxy) cmd_proxy "${2:-status}" ;;
		reconnect) cmd_reconnect ;;
		help|-h|--help) usage ;;
		*) usage; exit 1 ;;
	esac
}

[ -n "${TRAVEL_ROUTER_LIB:-}" ] || main "$@"
