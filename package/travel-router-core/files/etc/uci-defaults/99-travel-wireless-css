#!/bin/sh
# Append a small, scoped stylesheet to the active LuCI theme.
# This only affects the built-in Network -> Wireless overview.
for CSS in /www/luci-static/*/cascade.css; do
	[ -f "$CSS" ] || continue
	grep -q 'travel-wireless-fix' "$CSS" && continue
	cat >> "$CSS" <<'CSSEOF'

/* travel-wireless-fix: keep radio icons and rows readable */
#cbi-wireless .ifacebadge img,
#wifi_assoclist_table .ifacebadge img,
#cbi-wireless .cbi-section-table .ifacebadge img {
	width: 18px;
	height: 18px;
	object-fit: contain;
	vertical-align: middle;
}

#cbi-wireless .cbi-section {
	border: 1px solid #e4e7ec;
	border-radius: 10px;
	padding: 10px 12px;
	margin-bottom: 14px;
}

#cbi-wireless .cbi-section:nth-of-type(1) {
	border-left: 4px solid #12b76a;
}

#cbi-wireless .cbi-section:nth-of-type(2) {
	border-left: 4px solid #2e90fa;
}

#cbi-wireless .cbi-section:nth-of-type(1) h3::after {
	content: "  2.4 GHz";
	color: #12b76a;
	font-size: 12px;
	font-weight: 600;
}

#cbi-wireless .cbi-section:nth-of-type(2) h3::after {
	content: "  5 GHz";
	color: #2e90fa;
	font-size: 12px;
	font-weight: 600;
}

#cbi-wireless .cbi-section-table-row,
#wifi_assoclist_table tr {
	vertical-align: middle;
}

#wifi_assoclist_table td,
#wifi_assoclist_table th {
	padding-top: 8px;
	padding-bottom: 8px;
}
CSSEOF
done
exit 0
