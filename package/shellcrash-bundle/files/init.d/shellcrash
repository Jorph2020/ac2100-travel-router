#!/bin/sh /etc/rc.common

START=99
CRASHDIR=/etc/ShellCrash

SERVICE_DAEMONIZE=1
SERVICE_WRITE_PID=1
USE_PROCD=1

start_service() {
	[ -f "$CRASHDIR/configs/directories.env" ] && . "$CRASHDIR/configs/directories.env"
	[ -f "$CRASHDIR/configs/command.env" ] && . "$CRASHDIR/configs/command.env"
	[ -x "$CRASHDIR/starts/bfstart.sh" ] || return 1
	"$CRASHDIR/starts/bfstart.sh" || return 1

	procd_open_instance
	procd_set_param user root
	procd_set_param respawn
	procd_set_param command $COMMAND
	procd_set_param stderr 0
	procd_set_param stdout 0
	procd_close_instance

	[ -x "$CRASHDIR/starts/afstart.sh" ] && "$CRASHDIR/starts/afstart.sh" &
}

stop_service() {
	procd_close_instance
	[ -x "$CRASHDIR/starts/fw_stop.sh" ] && "$CRASHDIR/starts/fw_stop.sh"
}
