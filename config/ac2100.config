# Seed configuration for the Xiaomi/Redmi AC2100 travel router.
#
# The build script copies this file to .config and runs `make defconfig`,
# which resolves all dependencies and drops symbols for packages that are
# not available in the selected feeds.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

# Also build the initramfs image used by pb-boot installations
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# LuCI and the travel router UI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y
CONFIG_PACKAGE_luci-app-travel-router=y
CONFIG_PACKAGE_travel-router-core=y

# Chinese translations
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# OpenClash and its runtime dependencies
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y

# dnsmasq-full is required for nftset/ipset rule integration
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# Full wpad supports WPA3-SAE upstream networks and 802.11w
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set

# Recovery / flashing helpers
CONFIG_PACKAGE_mtd-utils=y

# Keep the image lean but useful
# CONFIG_PACKAGE_luci-app-commands is not set
# CONFIG_PACKAGE_luci-app-statistics is not set
# CONFIG_PACKAGE_luci-app-sqm is not set
