# Lite seed configuration: travel router without OpenClash/Ruby.
#
# The proxy role is left to ShellCrash, which is installed after flashing.
# This keeps the 128 MB RAM device responsive and leaves more flash free for
# the Mihomo core (about 20-25 MB) that ShellCrash downloads later.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y

# Initramfs is required for the pb-boot installation path
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# LuCI and the travel router UI
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-app-travel-router=y
CONFIG_PACKAGE_travel-router-core=y

# Chinese translations
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_luci-i18n-firewall-zh-cn=y
CONFIG_PACKAGE_luci-i18n-opkg-zh-cn=y

# ShellCrash prerequisites (curl, nftables/tproxy, tun) and helpers
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-inet-diag=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_PACKAGE_mtd-utils=y

# GUI command runner: lets you repair Wi-Fi from LuCI without SSH
CONFIG_PACKAGE_luci-app-commands=y
CONFIG_PACKAGE_luci-i18n-commands-zh-cn=y

# dnsmasq-full is used by ShellCrash for DNS integration
CONFIG_PACKAGE_dnsmasq-full=y
# CONFIG_PACKAGE_dnsmasq is not set

# Full wpad keeps WPA3-SAE upstream support
CONFIG_PACKAGE_wpad-mbedtls=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
